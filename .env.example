# ============================================================
# Cold Call Preparation — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Required API Keys ---
HUBSPOT_ACCESS_TOKEN=your-hubspot-oauth-token-here
OCTAVE_API_KEY=your-octave-api-key-here
SLACK_WEBHOOK_URL=your-slack-webhook-url-here

# --- Octave Agent OIDs ---
OCTAVE_CONTENT_AGENT=ca_DLoI5XBlw9qGNEDBiV1a2

# --- HubSpot ---
HUBSPOT_PORTAL_ID=46940643
HUBSPOT_CREATOR_ID=87514817

# --- Slack ---
SLACK_CHANNEL_ID=C0AELNTNNDV

# --- Oracle v2: Webhook Auth ---
# The signal webhook rejects all requests when this is empty.
SIGNAL_WEBHOOK_API_KEY=generate-a-long-random-key-here

# --- Auth ---
# The shared password the BDR types on the sign-in page.
# Empty means the gate rejects every login. Generate: openssl rand -base64 18
SUMMIT_PASSWORD=
# Signs the session cookie. Generate: openssl rand -hex 32
FLASK_SECRET_KEY=

# --- Thresholds ---
QUAL_THRESHOLD=8

# --- Server ---
FLASK_PORT=5001
FLASK_DEBUG=true
